# Private Nuxt runtime configuration. Never put these under runtimeConfig.public.
# Copy to apps/portal/.env for local development only.
# Production: supply these in the process environment; .env is not read by node .output.
NUXT_NOVA_PUBLIC_URL=
NUXT_NOVA_GATEWAY_URL=
NUXT_NOVA_GATEWAY_SERVICE_KEY=
NUXT_NOVA_GATEWAY_TIMEOUT_MS=10000
NUXT_NOVA_SHOWCASE_PATH=
NUXT_NOVA_NEXUS_PATH=
NUXT_NOVA_HUB_TOKEN_SECRET=
NUXT_NOVA_HUB_ISSUER=
NUXT_NOVA_HUB_AUDIENCE=
# Explicitly allow HTTP only for localhost/127.0.0.1 integration tests, never remote hosts.
NUXT_NOVA_ALLOW_LOCAL_HTTP=false
HOST=127.0.0.1
PORT=4000
