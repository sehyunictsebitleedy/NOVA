{
    "name":  "sebit-nova",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "engines":  {
                    "node":  "\u003e=24"
                },
    "scripts":  {
                    "prepare:assets":  "node scripts/prepare-assets.mjs",
                    "dev":  "npm run prepare:assets \u0026\u0026 npm run dev --workspace @sebit-nova/portal",
                    "build":  "npm run prepare:assets \u0026\u0026 npm run build --workspace @sebit-nova/portal",
                    "start":  "node scripts/start.mjs",
                    "typecheck":  "npm run typecheck --workspace @sebit-nova/portal",
                    "test":  "vitest run",
                    "dev:static":  "node scripts/serve.mjs",
                    "test:integration":  "node tests/integration.mjs",
                    "test:ux":  "node tests/ux-browser.cjs",
                    "test:grid":  "node tests/grid-browser.cjs"
                },
    "devDependencies":  {
                            "@playwright/test":  "^1.64.0",
                            "@types/node":  "^24.0.0",
                            "h3":  "1.15.11",
                            "jose":  "6.2.17",
                            "typescript":  "~5.9.3",
                            "vitest":  "5.1.0",
                            "vue-tsc":  "3.3.14"
                        }
}
